//! The Silk side of the example: the same two benchmarks as the C, Rust and Go programs.

import silk.bench.harness { Harness }
import silk.bench.transport { StreamTransport, Transport, TransportError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.system.host_input { HostInput }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }

// FNV-1a over the numbers below `length`.
fn hash(length: u64) -> u64 {
  let mut total: u64 = 14695981039346656037
  let mut at: u64 = 0
  while at < length {
    total = u64.wrappingMultiply(u64.bitXor(total, at), 1099511628211)
    at = at + 1
  }
  return total
}

effect fn benchmarks() -> i32
  ! TransportError | OutOfMemoryError
  ? &mut Transport | &mut Allocator | &mut MonotonicClock | &mut HostInput {
  let mut harness = run Harness.open(&["Hash/n=1000", "Hash/n=100000"])
  while run harness.next() {
    let length: u64 = if harness.position() == 0 {
      1000
    } else {
      100000
    }
    let mut left = harness.iterations()
    let mut total: u64 = 0
    while left > 0 {
      // One iteration: the work whose time is reported.
      Harness.keep<u64>(&length)
      total = hash(length)
      Harness.keep<u64>(&total)
      left = left - 1
    }
    run harness.checkNumber(total)
  }
  return 0
}

effect fn failed(error: TransportError | OutOfMemoryError) -> i32 {
  drop error
  return 1
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut transport = StreamTransport.standard()
  let mut clock = OsMonotonicClock.make()
  return run Effect.catchAll(benchmarks(), failed)
    |> Effect.provideMut<Transport>(&mut transport)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
